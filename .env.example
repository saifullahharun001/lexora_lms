NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lexora_lms?schema=public
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/lexora_lms?schema=public

REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET=replace-with-64-char-random-string
JWT_ACCESS_TTL=15m
JWT_ISSUER=lexora-api
JWT_AUDIENCE=lexora-web

JWT_REFRESH_SECRET=replace-with-another-64-char-random-string
JWT_REFRESH_TTL=30d
REFRESH_TOKEN_COOKIE_NAME=lexora_rt
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_DOMAIN=localhost

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Lexora LMS
SMTP_FROM_EMAIL=no-reply@lexora.local

OTP_ISSUER=Lexora LMS
OTP_DIGITS=6
OTP_TTL_SECONDS=300
OTP_RATE_LIMIT_PER_WINDOW=5
TWO_FACTOR_ENCRYPTION_KEY=replace-with-32-byte-key

# Generic API storage endpoint; evaluation deployments use the selected internal MinIO IPv4, while client delivery remains separate.
S3_ENDPOINT=https://replace-with-internal-object-storage-endpoint
S3_REGION=us-east-1
S3_BUCKET=replace-with-private-bucket-name
S3_ACCESS_KEY=replace-with-dedicated-application-access-key
S3_SECRET_KEY=replace-with-dedicated-application-secret-key
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=https://replace-with-controlled-delivery-base-url
FILE_CONTENT_INSPECTION_TIMEOUT_MS=5000

# Required only by the isolated MinIO evaluation runtime; use its dedicated numeric secret-reader group GID.
LEXORA_MINIO_SECRET_GID=replace-with-dedicated-secret-reader-group-gid
# Select these non-secret values only after checking host routes and existing Docker networks for overlap.
LEXORA_MINIO_SUBNET=replace-with-non-overlapping-private-cidr
LEXORA_MINIO_GATEWAY=replace-with-gateway-inside-selected-cidr
LEXORA_MINIO_IPV4=replace-with-minio-ip-inside-selected-cidr

MALWARE_SCANNER_MODE=clamav
MALWARE_SCANNER_HOST=localhost
MALWARE_SCANNER_PORT=3310
MALWARE_SCANNER_TIMEOUT_MS=10000

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

WEB_APP_URL=http://localhost:3000
API_APP_URL=http://localhost:4000
PUBLIC_VERIFICATION_URL=http://localhost:3000/verify
ALLOWED_ORIGINS=http://localhost:3000

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_TTL_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10
UNIVERSITY_EMAIL_DOMAINS=
AUTH_LOCKOUT_FAILURE_THRESHOLD=5
AUTH_LOCKOUT_WINDOW_MINUTES=15
AUTH_LOCKOUT_DURATION_MINUTES=15

PORT=4000
